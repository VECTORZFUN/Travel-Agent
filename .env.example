# Server Configuration
PORT=3001
NODE_ENV=development

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/travelai
MONGODB_URI=mongodb://localhost:27017/travelai

# Redis Cache
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# External APIs

# Flights
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
SKYSCANNER_API_KEY=your_skyscanner_api_key
DUFFEL_API_TOKEN=your_duffel_api_token

# Hotels
BOOKING_COM_API_KEY=your_booking_com_api_key
EXPEDIA_API_KEY=your_expedia_api_key
HOTELS_COM_API_KEY=your_hotels_com_api_key

# Activities
GETYOURGUIDE_API_KEY=your_getyourguide_api_key
VIATOR_API_KEY=your_viator_api_key

# Maps & Places
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Images
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Payments
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@travelai.com

# SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret_here

# File Upload
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=debug